  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_desc}",
  "authors": [
    "ByThePowerOfScience"
  ],
  "contact": {
    "homepage": ""
  },
  "license": "MIT",
  "icon": "",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
