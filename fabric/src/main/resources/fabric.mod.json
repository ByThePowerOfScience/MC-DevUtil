  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.8",
    "java": ">=21",
    "architectury": ">=17.0.8",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.3+kotlin.2.1.21"
